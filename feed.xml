    <item>
      <title>Eruption Extends Iwo Jima’s Beach</title>
      <link>https://science.nasa.gov/earth/earth-observatory/eruption-extends-iwo-jimas-beach/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/eruption-extends-iwo-jimas-beach/</guid>
      <pubDate>Tue, 24 Nov 2026 05:01:00 +0000</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/eruption-enlarges-iwo-jima%E2%80%99s-beach/iwojima_oli2_20261111_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Eruption Extends Iwo Jima’s Beach"&gt;&lt;p&gt;A volcanic eruption just off the southeast shore of the Pacific island has reshaped the coast, but it’s unclear how long the new land will survive.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/eruption-enlarges-iwo-jima%E2%80%99s-beach/iwojima_oli2_20261111_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
    </item>
    <item>
      <title>Laser Focus at the Top of the World</title>
      <link>https://science.nasa.gov/earth/earth-observatory/laser-focus-at-the-top-of-the-world/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/laser-focus-at-the-top-of-the-world/</guid>
      <pubDate>Mon, 23 Nov 2026 05:01:00 +0000</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/laser-focus-at-the-top-of-the-world/svalbardzm_oli2_20260730_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Laser Focus at the Top of the World"&gt;&lt;p&gt;A next-generation geodetic instrument developed by NASA, part of a network that helps measure satellites’ orbits and the planet’s shape, has debuted in Svalbard, Norway.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/laser-focus-at-the-top-of-the-world/svalbardzm_oli2_20260730_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
    </item>
    <item>
      <title>The Stormy Southwest Pacific</title>
      <link>https://science.nasa.gov/earth/earth-observatory/the-stormy-southwest-pacific/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/the-stormy-southwest-pacific/</guid>
      <pubDate>Fri, 20 Nov 2026 05:01:00 +0000</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/the-stormy-southwest-pacific--/cyclonexavier_amo_20261116_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="The Stormy Southwest Pacific"&gt;&lt;p&gt;Tropical Cyclone Xavier launched the basin’s storm season with a bang.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/the-stormy-southwest-pacific--/cyclonexavier_amo_20261116_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
    </item>
    <item>
      <title>El Niño Rains Paint the Atacama</title>
      <link>https://science.nasa.gov/earth/earth-observatory/el-nino-rains-paint-the-atacama/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/el-nino-rains-paint-the-atacama/</guid>
      <pubDate>Thu, 19 Nov 2026 05:00:00 +0000</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/el-ni%C3%B1o-rains-paint-the-atacama/atacamabloom_oli2_20261024_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="El Niño Rains Paint the Atacama"&gt;&lt;p&gt;Winter precipitation helped wake dormant seeds in northern Chile, carpeting the desert with what may be the region’s most extensive flowering of the satellite era.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/el-ni%C3%B1o-rains-paint-the-atacama/atacamabloom_oli2_20261024_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
    </item>
    <item>
      <title>Sierra Snow Season Spins Up</title>
      <link>https://science.nasa.gov/earth/earth-observatory/sierra-snow-season-spins-up/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/sierra-snow-season-spins-up/</guid>
      <pubDate>Wed, 18 Nov 2026 05:01:00 +0000</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/sierra-snow-season-spins-up/sierranevada_tmo_20261114_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Sierra Snow Season Spins Up"&gt;&lt;p&gt;A widespread, early-season snowstorm blanketed California’s mountains in white in mid-November 2026.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/sierra-snow-season-spins-up/sierranevada_tmo_20261114_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
