    <item>
      <title>Before the Dawn in America’s Heartland</title>
      <link>https://science.nasa.gov/earth/earth-observatory/before-the-dawn-in-americas-heartland/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/before-the-dawn-in-americas-heartland/</guid>
      <pubDate>Wed, 04 Nov 2026 00:01:00 -0500</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/before-the-dawn-in-america’s-heartland/ISS075-E-226709_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Before the Dawn in America’s Heartland"&gt;&lt;p&gt;With hardly a cloud in sight, astronauts had a sweeping view of nighttime lights in the U.S. Midwest.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/before-the-dawn-in-america’s-heartland/ISS075-E-226709_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
