    <item>
      <title>Autumn Mornings Bring Valley Fog</title>
      <link>https://science.nasa.gov/earth/earth-observatory/autumn-mornings-bring-valley-fog/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/autumn-mornings-bring-valley-fog/</guid>
      <pubDate>Tue, 10 Nov 2026 00:00:00 -0500</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/autumn-mornings-bring-valley-fog/usvalleyfog_tmo_20261108_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Autumn Mornings Bring Valley Fog"&gt;&lt;p&gt;Low clouds trace the branching valleys of the Appalachian Plateau and the Cumberland River, then burn off by afternoon.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/autumn-mornings-bring-valley-fog/usvalleyfog_tmo_20261108_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
    </item>
    <item>
      <title>Ozone Hole Reaches Its 2026 Maximum</title>
      <link>https://science.nasa.gov/earth/earth-observatory/ozone-hole-reaches-its-2026-maximum/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/ozone-hole-reaches-its-2026-maximum/</guid>
      <pubDate>Mon, 09 Nov 2026 00:00:00 -0500</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/ozone-hole-reaches-its-2026-maximum/ozone_geos5_20260918_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Ozone Hole Reaches Its 2026 Maximum"&gt;&lt;p&gt;The ozone hole ranked seventh largest by area in 48 years of monitoring, but it was not as deep as other large holes on record.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/ozone-hole-reaches-its-2026-maximum/ozone_geos5_20260918_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
    </item>
    <item>
      <title>Taking a Gander at Utah’s Goosenecks</title>
      <link>https://science.nasa.gov/earth/earth-observatory/taking-a-gander-at-utahs-goosenecks/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/taking-a-gander-at-utahs-goosenecks/</guid>
