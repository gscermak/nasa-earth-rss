    <item>
      <title>Shivelyuch Socked In</title>
      <link>https://science.nasa.gov/earth/earth-observatory/shivelyuch-socked-in/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/shivelyuch-socked-in/</guid>
      <pubDate>Fri, 27 Nov 2026 05:01:00 +0000</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/shivelyuch-socked-in/shivelyuchcloud_oli2_20261108_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Shivelyuch Socked In"&gt;&lt;p&gt;A cloud layer encircled the flanks of the volcano on the Kamchatka Peninsula but left its restless summit caldera in view.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/shivelyuch-socked-in/shivelyuchcloud_oli2_20261108_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
    </item>
    <item>
      <title>Seeking Refuge on Resolution Island</title>
      <link>https://science.nasa.gov/earth/earth-observatory/seeking-refuge-on-resolution-island/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/seeking-refuge-on-resolution-island/</guid>
      <pubDate>Thu, 26 Nov 2026 05:01:00 +0000</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/seeking-refuge-on-resolution-island/nzresolution_oli2_20251212_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Seeking Refuge on Resolution Island"&gt;&lt;p&gt;New Zealanders have long envisioned the island as a predator-free zone for native birds, but swimming stoats have shown a resolve of their own.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/seeking-refuge-on-resolution-island/nzresolution_oli2_20251212_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
    </item>
    <item>
      <title>Georgia’s Pecan Belt</title>
      <link>https://science.nasa.gov/earth/earth-observatory/georgias-pecan-belt/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/georgias-pecan-belt/</guid>
      <pubDate>Wed, 25 Nov 2026 05:00:00 +0000</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/georgia%E2%80%99s-pecan-belt/georgiapecans_oli_20261023_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Georgia’s Pecan Belt"&gt;&lt;p&gt;Since an early-1900s planting boom, orchards along the Flint River in southwest Georgia have become a center of U.S. pecan production.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/georgia%E2%80%99s-pecan-belt/georgiapecans_oli_20261023_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
    </item>
    <item>
      <title>Eruption Extends Iwo Jima’s Beach</title>
      <link>https://science.nasa.gov/earth/earth-observatory/eruption-extends-iwo-jimas-beach/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/eruption-extends-iwo-jimas-beach/</guid>
      <pubDate>Tue, 24 Nov 2026 05:01:00 +0000</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/eruption-enlarges-iwo-jima%E2%80%99s-beach/iwojima_oli2_20261111_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Eruption Extends Iwo Jima’s Beach"&gt;&lt;p&gt;A volcanic eruption just off the southeast shore of the Pacific island has reshaped the coast, but it’s unclear how long the new land will survive.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/eruption-enlarges-iwo-jima%E2%80%99s-beach/iwojima_oli2_20261111_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
    </item>
    <item>
      <title>Laser Focus at the Top of the World</title>
      <link>https://science.nasa.gov/earth/earth-observatory/laser-focus-at-the-top-of-the-world/</link>
      <guid isPermaLink="true">https://science.nasa.gov/earth/earth-observatory/laser-focus-at-the-top-of-the-world/</guid>
      <pubDate>Mon, 23 Nov 2026 05:01:00 +0000</pubDate>
      <description>&lt;img src="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/laser-focus-at-the-top-of-the-world/svalbardzm_oli2_20260730_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Laser Focus at the Top of the World"&gt;&lt;p&gt;A next-generation geodetic instrument developed by NASA, part of a network that helps measure satellites’ orbits and the planet’s shape, has debuted in Svalbard, Norway.&lt;/p&gt;</description>
      <media:thumbnail url="https://assets.science.nasa.gov/content/dam/science/esd/eo/images/iotd/2026/laser-focus-at-the-top-of-the-world/svalbardzm_oli2_20260730_th.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" />
    </item>
